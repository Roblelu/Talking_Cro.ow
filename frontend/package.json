{
  "name": "talking-crow",
  "private": true,
  "version": "1.0.5",
  "description": "Talking Crow Desktop App",
  "author": "Roblelu <rooblelu@gmail.com>",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5175 && npm run start-electron\"",
    "start-electron": "electron .",
    "build": "vite build",
    "electron:build": "electron-builder --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "firebase": "^12.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.roblelu.talkingcrow",
    "productName": "Talking Crow",
    "artifactName": "Talking_Cro.ow_${version}.${ext}",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "app.exe"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Roblelu",
        "repo": "Talking_Cro.ow"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/logo.png"
    },
    "icon": "src/assets/logo.png"
  }
}
