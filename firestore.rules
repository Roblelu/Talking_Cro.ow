rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Bloqueo de acceso por defecto (Zero Trust)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // 2. Reglas para los perfiles de fans de un streamer
    match /streamers/{streamerId}/fans/{uid} {
      // El perfil general (username, croins) puede ser leído por cualquier usuario logueado
      allow read: if request.auth != null;
      
      // La creación y actualización de su perfil general solo la puede hacer el propio usuario
      allow write: if request.auth != null && request.auth.uid == uid;
      
      // 3. Subcolección privada de contacto (PII)
      match /private/contact {
        // Estrictamente: Solo el dueño de la cuenta puede leer o modificar su información de contacto
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
