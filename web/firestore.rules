rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Bloqueo de acceso por defecto (Zero Trust)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // 2. Colección global de nombres de usuario para verificación única (Anti-Enumeración estricta)
    match /usernames/{username} {
      allow get: if true; // Permite verificar si un username existe
      allow list: if false; // Bloquea obtener la lista de todos los usuarios
      allow write: if request.auth != null; // Solo usuarios autenticados pueden registrar su username
    }

    // 3. Reglas para perfiles unificados (creadores y donadores)
    match /users/{uid} {
      // El perfil general solo puede ser leído por el propio usuario
      allow read: if request.auth != null && request.auth.uid == uid;
      
      // La creación exige iniciar los saldos en 0
      allow create: if request.auth != null && request.auth.uid == uid 
                    && request.resource.data.purchased_croins == 0
                    && request.resource.data.promotional_croins == 0
                    && request.resource.data.creator_credits == 0
                    && request.resource.data.creator_earnings == 0
                    && request.resource.data.isPro == false;
                    
      // Las actualizaciones del perfil general desde el cliente no pueden alterar los saldos o privilegios
      // (Los saldos solo pueden ser modificados por Firebase Functions/Admin)
      allow update: if request.auth != null && request.auth.uid == uid 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'purchased_croins', 'promotional_croins', 'creator_credits', 'creator_earnings', 'isPro'
                    ]);
      
      // 4. Subcolección privada de contacto (PII)
      match /private/contact {
        // Estrictamente: Solo el dueño de la cuenta puede leer o modificar su información de contacto
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
