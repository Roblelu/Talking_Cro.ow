{
  "name": "functions",
  "description": "Cloud Functions for Talking Cro.ow Backend",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test tests/*.test.cjs"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "form-data": "^4.0.6",
    "stripe": "^22.5.0",
    "wtfnode": "^0.10.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "private": true
}
