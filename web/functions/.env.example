# Server-only configuration. Copy values into the deployed functions environment.
PREMIUM_TTS_API_KEY=
# Required semantic moderation. Outages reject requests without charging.
GEMINI_API_KEY=
# Override when migrating the semantic moderation model.
GEMINI_MODERATION_MODEL=gemini-3.5-flash-lite

# Dedicated Firebase identity for the central bot (must match VM configuration).
ECO_BOT_UID=talking-crow-central-bot
